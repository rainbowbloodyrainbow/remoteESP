CONFIG_IDF_TARGET="esp32"
CONFIG_MICRO_ROS_ESP_XRCE_DDS_MIDDLEWARE=y
CONFIG_MICRO_ROS_ESP_NETIF_WLAN=y
CONFIG_ESP_WIFI_SSID=""
CONFIG_ESP_WIFI_PASSWORD=""
CONFIG_MICRO_ROS_AGENT_IP="0.0.0.0"
CONFIG_MICRO_ROS_AGENT_PORT="8888"
CONFIG_CAR_MOTORS_ENABLE=y
CONFIG_CAR_PWM_LIMIT=1023
CONFIG_CAR_LINEAR_PPS_PER_MPS=10000
CONFIG_CAR_TURN_PPS_PER_RAD_S=1000
CONFIG_CAR_MAPPING_CALIBRATED=y
CONFIG_CAR_WHEEL_DIAMETER_TENTH_MM=473
CONFIG_CAR_TRACK_TENTH_MM=1334
CONFIG_CAR_TICKS_PER_REV=10200
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
